generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RegistrationLink {
  id               String         @id @default(cuid())
  token            String         @unique @default(cuid())
  ownerSecretHash  String
  active           Boolean        @default(true)
  maxRegistrations Int            @default(5)
  registrations    Registration[]
  otps             EmailOtp[]
  createdAt        DateTime       @default(now())
  payments         Payment[]
}

model Registration {
  id                     String           @id @default(cuid())
  name                   String
  email                  String
  linkId                 String
  link                   RegistrationLink @relation(fields: [linkId], references: [id])
  cancellationSecretHash String?
  createdAt              DateTime         @default(now())

  @@unique([linkId, email])
  @@index([linkId])
}

model EmailOtp {
  id         String           @id @default(cuid())
  email      String
  codeHash   String
  linkId     String
  link       RegistrationLink @relation(fields: [linkId], references: [id])
  expiresAt  DateTime
  attempts   Int              @default(0)
  verifiedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([linkId, email])
}

model Payment {
  id     String           @id @default(cuid())
  linkId String
  link   RegistrationLink @relation(fields: [linkId], references: [id])

  name  String
  email String

  orderId   String  @unique
  paymentId String? @unique

  amount   Int    @default(10000)
  currency String @default("INR")
  status   String @default("PENDING")

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linkId, status])
  @@index([linkId, email])
}
